function(sheet_ncnn_set name value)
    set(${name} ${value} CACHE BOOL "" FORCE)
endfunction()

sheet_ncnn_set(NCNN_SHARED_LIB OFF)
sheet_ncnn_set(NCNN_INSTALL_SDK OFF)
sheet_ncnn_set(NCNN_BUILD_TOOLS OFF)
sheet_ncnn_set(NCNN_BUILD_EXAMPLES OFF)
sheet_ncnn_set(NCNN_BUILD_BENCHMARK OFF)
sheet_ncnn_set(NCNN_BUILD_TESTS OFF)
sheet_ncnn_set(NCNN_PYTHON OFF)
sheet_ncnn_set(NCNN_C_API OFF)
sheet_ncnn_set(NCNN_VULKAN OFF)
sheet_ncnn_set(NCNN_BENCHMARK OFF)

sheet_ncnn_set(NCNN_PIXEL OFF)
sheet_ncnn_set(NCNN_PIXEL_ROTATE OFF)
sheet_ncnn_set(NCNN_PIXEL_AFFINE OFF)
sheet_ncnn_set(NCNN_PIXEL_DRAWING OFF)
sheet_ncnn_set(NCNN_SIMPLEOCV OFF)

sheet_ncnn_set(NCNN_INT8 OFF)
sheet_ncnn_set(NCNN_BF16 OFF)
sheet_ncnn_set(NCNN_WEIGHT_QUANT OFF)
sheet_ncnn_set(NCNN_ARM82 OFF)
sheet_ncnn_set(NCNN_ARM82DOT OFF)
sheet_ncnn_set(NCNN_ARM82FP16FML OFF)
sheet_ncnn_set(NCNN_ARM84BF16 OFF)
sheet_ncnn_set(NCNN_ARM84I8MM OFF)
sheet_ncnn_set(NCNN_ARM86SVE OFF)
sheet_ncnn_set(NCNN_ARM86SVE2 OFF)
sheet_ncnn_set(NCNN_ARM86SVEBF16 OFF)
sheet_ncnn_set(NCNN_ARM86SVEI8MM OFF)
sheet_ncnn_set(NCNN_ARM86SVEF32MM OFF)

sheet_ncnn_set(NCNN_AVX512 OFF)
sheet_ncnn_set(NCNN_AVXVNNI OFF)
sheet_ncnn_set(NCNN_AVXVNNIINT8 OFF)
sheet_ncnn_set(NCNN_AVXVNNIINT16 OFF)
sheet_ncnn_set(NCNN_AVXNECONVERT OFF)
sheet_ncnn_set(NCNN_XOP OFF)
sheet_ncnn_set(NCNN_FMA4 OFF)

file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/layers.config" _wanted REGEX "^[A-Za-z]")

file(STRINGS "${NCNN_SOURCE_DIR}/src/CMakeLists.txt" _ncnn_layer_lines REGEX "^ncnn_add_layer\\(")
set(_kept "")
foreach(_line IN LISTS _ncnn_layer_lines)
    string(REGEX REPLACE "^ncnn_add_layer\\(([A-Za-z0-9_]+).*" "\\1" _layer "${_line}")
    string(TOLOWER "${_layer}" _lower)
    if(_layer IN_LIST _wanted)
        sheet_ncnn_set(WITH_LAYER_${_lower} ON)
        list(APPEND _kept ${_layer})
    else()
        sheet_ncnn_set(WITH_LAYER_${_lower} OFF)
    endif()
endforeach()
foreach(_layer IN LISTS _wanted)
    if(NOT _layer IN_LIST _kept)
        message(FATAL_ERROR "NCNN has no layer named ${_layer}; check native/layers.config")
    endif()
endforeach()
